{
  "name": "simple-ai-chat-export",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "python3 scripts/package.py && playwright test",
    "preview": "node scripts/preview.js",
    "inspect:live": "node scripts/live-profile.js",
    "check": "node scripts/check.js",
    "format:check": "prettier --check .",
    "package": "python3 scripts/package.py",
    "store:assets": "node scripts/store-assets.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9"
  },
